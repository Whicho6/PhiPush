<view class="page"><input class="search" placeholder="搜索歌曲" bindinput="search"/><scroll-view scroll-x class="tabs"><view wx:for="{{diffs}}" wx:key="*this" class="tab {{diff===item?'active':''}}" data-value="{{item}}" bindtap="diff">{{item||'全部'}}</view></scroll-view><view class="tabs" style="margin-top:18rpx"><view wx:for="{{sorts}}" wx:key="key" class="tab {{sort===item.key?'active':''}}" data-value="{{item.key}}" bindtap="sort">{{item.name}}</view></view><view wx:for="{{shown}}" wx:key="song_id" class="card"><view class="row"><view>{{item.song}} <text class="pill">{{item.difficulty}}</text></view><view class="gain">{{item.chart_rks}}</view></view><view class="row muted small"><text>定数 {{item.constant||'?'}}</text><text>ACC {{item.accuracy}}%</text><text>{{item.ap?'AP':item.fc?'FC':'—'}}</text></view></view></view>
