<view class="page"><view class="section">Best Push Opportunities</view><view wx:for="{{items}}" wx:key="song_id" class="card"><view class="row"><view class="rank">#{{index+1}}</view><view style="flex:1"><view>{{item.song}}</view><text class="pill">{{item.difficulty}} {{item.constant}}</text></view><view class="gain">+{{item.estimated_total_rks_gain}}</view></view><view class="row small" style="margin-top:24rpx"><text>{{item.accuracy}}%</text><text>→</text><text class="acid">{{item.target_accuracy}}%</text></view><view class="muted small">{{item.reason}}</view></view></view>
