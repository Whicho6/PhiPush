# Optional overrides. Never put a real SessionToken in this file.
PHIPUSH_HOST=127.0.0.1
PHIPUSH_PORT=8000
PHIPUSH_SESSION_TTL=900
PHIPUSH_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# TapTap/LeanCloud public client configuration overrides.
# PHIGROS_CLIENT_ID=
# PHIGROS_CLIENT_TOKEN=
# LEANCLOUD_APP_ID=
# LEANCLOUD_APP_KEY=
# PHIGROS_AES_KEY_B64=
# PHIGROS_AES_IV_B64=

# 可选：本地完整曲库路径；默认 data/charts.json
PHIPUSH_CHART_DATA=
